# Local / agent examples — no real values. Live Worker uses wrangler secrets.

# Cloudflare (deploy / API)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Compose HTTP API (Bearer) — also: wrangler secret put COMPOSE_API_TOKEN
# COMPOSE_API_TOKEN=

# Outbound SMTP is configured in ROUTING_YAML under providers: (not free-standing
# SMTP_HOST). Auth values are whole-value ${SECRET_NAME} refs, e.g.:
# SMTP_PRIMARY_USERNAME=
# SMTP_PRIMARY_PASSWORD=
# (names must match providers.<id>.config username/password refs)

# Live routing is NOT a local .env file — use:
#   npx wrangler secret put ROUTING_YAML < config/routing.local.yaml
